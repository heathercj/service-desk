# Copy to .env and fill in real values for your environment.
# Never commit a real .env file. See README.md and docs/ARCHITECTURE.md.

# --- Core ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Database (Docker Compose defaults, see docker-compose.yml) ---
DATABASE_URL="postgresql://service_desk:service_desk_dev_password@localhost:5432/service_desk?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-value"
AUTH_URL="http://localhost:3000"

# --- Microsoft Entra ID (single-tenant only; never "common"/"organizations"/"consumers") ---
# See docs/ENTRA_SETUP.md for full app-registration walkthrough.
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_SECRET="replace-with-app-registration-client-secret"

# --- Development-only authentication bypass ---
# NEVER set to true in production. The app refuses to start if
# ENABLE_DEV_AUTH=true and NODE_ENV=production.
ENABLE_DEV_AUTH=true

# The guided demo tour (Henry). Requires ENABLE_DEV_AUTH, since it signs
# itself in as seeded dev identities. Refused in production for the same reason.
ENABLE_DEMO_TOUR=true

# --- Local object storage (Section 14) ---
OBJECT_STORAGE_ROOT="./storage/uploads"
OBJECT_STORAGE_MAX_FILE_BYTES=10485760
OBJECT_STORAGE_MAX_TOTAL_BYTES=52428800

# --- Email provider (Section 9) ---
EMAIL_PROVIDER="console"

# --- AI / semantic similarity provider (Section 6, 11, 12) ---
# "local" uses deterministic full-text + trigram similarity, no API key required.
AI_PROVIDER="local"

# --- Rate limiting (Section 15) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
