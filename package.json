{
  "name": "service-desk",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.11.0 <23",
    "pnpm": "9.15.4"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "preflight": "tsx --tsconfig scripts/tsconfig.json scripts/preflight.ts",
    "tdd:audit": "tsx --tsconfig scripts/tsconfig.json scripts/tdd-audit.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "cross-env RATE_LIMIT_AUTH_MAX=1000 playwright test",
    "build:e2e": "cross-env ENABLE_DEV_AUTH=false ENABLE_DEMO_TOUR=false next build",
    "e2e:server": "tsx --tsconfig scripts/tsconfig.json scripts/e2e-server.ts",
    "test:e2e:built": "pnpm build:e2e && cross-env NODE_ENV=test RATE_LIMIT_AUTH_MAX=1000 E2E_WEB_SERVER=\"pnpm e2e:server\" playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && pnpm db:search:setup",
    "db:migrate:deploy": "prisma migrate deploy && pnpm db:search:setup",
    "db:search:setup": "tsx --tsconfig scripts/tsconfig.json scripts/db-search-setup.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:baseline": "tsx --tsconfig scripts/tsconfig.json scripts/seed-production-baseline.ts",
    "bootstrap:admin": "tsx --tsconfig scripts/tsconfig.json scripts/bootstrap-admin.ts",
    "db:reset": "tsx --tsconfig scripts/tsconfig.json scripts/db-reset.ts",
    "kb:reindex": "tsx --tsconfig scripts/tsconfig.json scripts/kb-reindex.ts",
    "kb:validate": "tsx --tsconfig scripts/tsconfig.json scripts/kb-validate.ts",
    "sbom": "pnpm dlx @cyclonedx/cdxgen@11 -t pnpm -o sbom.cdx.json --no-recurse",
    "sim:run": "tsx --tsconfig scripts/tsconfig.json scripts/sim-run.ts",
    "demo:clean": "tsx --tsconfig scripts/tsconfig.json scripts/demo-clean.ts",
    "graph:subscribe": "tsx --tsconfig scripts/tsconfig.json scripts/graph-subscribe.ts",
    "dormant:check": "tsx --tsconfig scripts/tsconfig.json scripts/check-dormant-tickets.ts",
    "demo:prep": "tsx --tsconfig scripts/tsconfig.json scripts/demo-prep.ts",
    "demo:build": "cross-env ENABLE_DEV_AUTH=true ENABLE_DEMO_TOUR=true next build",
    "demo:serve": "tsx --tsconfig scripts/tsconfig.json scripts/demo-serve.ts",
    "security": "pnpm security:secrets && pnpm security:sca && pnpm security:sast && pnpm security:container",
    "security:sast": "semgrep --config p/typescript --config p/react --config p/nextjs --error --severity ERROR .",
    "security:sca": "osv-scanner scan --lockfile=pnpm-lock.yaml && pnpm audit --audit-level=high || true",
    "security:secrets": "gitleaks detect --source . --no-git -v",
    "security:dast": "bash scripts/security-dast-local.sh",
    "security:container": "trivy fs --severity HIGH,CRITICAL .",
    "ci:local": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@prisma/client": "6.1.0",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "file-type": "21.3.2",
    "gray-matter": "4.0.3",
    "lucide-react": "0.469.0",
    "next": "15.5.21",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.4",
    "pg": "8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.54.2",
    "react-markdown": "9.0.3",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tailwind-merge": "2.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "dotenv": "16.4.7",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.21",
    "eslint-config-prettier": "9.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.23",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.9",
    "prisma": "6.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3",
      "postcss": "8.5.23",
      "@eslint/plugin-kit": "0.3.4"
    }
  }
}
